/**
 * PRISMA SCHEMA - prisma/schema.prisma
 *
 * Purpose: Database schema definition for ParentHub
 * Database: SQLite (free, local, no setup required)
 *
 * Models:
 * - User: Parents, providers, admins
 * - Provider: Service provider listings
 * - Category: Service categories (hierarchical)
 * - Review: User reviews for providers
 * - Favorite: User saved providers
 * - AnalyticsEvent: Tracked events
 * - ClickLedger: Monetization tracking
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USER ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  image         String?
  role          String    @default("USER") // USER, PROVIDER, ADMIN

  // Relations
  provider      Provider?
  reviews       Review[]
  favorites     Favorite[]
  accounts      Account[]
  sessions      Session[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime?
  deletedAt     DateTime?

  @@index([email])
  @@index([phone])
  @@index([role])
}

// ============ AUTH (NextAuth) ============

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ PROVIDER ============

model Provider {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])

  // Basic info
  name            String
  slug            String    @unique
  description     String
  bio             String?

  // Media (JSON array as string for SQLite)
  photos          String    @default("[]")

  // Services (JSON array as string for SQLite)
  services        String    @default("[]")
  priceBand       String    @default("MIDRANGE") // BUDGET, MIDRANGE, PREMIUM
  languages       String    @default("[]")

  // Schedule (JSON)
  schedule        String?
  isAvailable     Boolean   @default(true)

  // Contact
  phone           String
  whatsapp        String?
  email           String?
  website         String?

  // Location
  address         String
  city            String
  neighborhoods   String    @default("[]")
  lat             Float
  lng             Float
  serviceRadius   Int?

  // Status & Verification
  status          String    @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?

  // Monetization
  featuredRank    Int       @default(0)
  sponsorBadge    Boolean   @default(false)

  // Admin
  adminNotes      String?
  approvedBy      String?
  approvedAt      DateTime?

  // Relations
  categories      CategoryProvider[]
  reviews         Review[]
  favorites       Favorite[]
  clickLedger     ClickLedger[]
  analyticsEvents AnalyticsEvent[]

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([city])
  @@index([isAvailable])
  @@index([featuredRank])
}

// ============ CATEGORY ============

model Category {
  id          String             @id @default(cuid())
  name        String
  nameHe      String
  slug        String             @unique
  icon        String?
  description String?

  // Hierarchy
  parentId    String?
  parent      Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]         @relation("CategoryHierarchy")

  // Display
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)

  // Relations
  providers   CategoryProvider[]

  // Timestamps
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
}

// Junction table for Provider-Category many-to-many
model CategoryProvider {
  providerId String
  categoryId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
}

// ============ REVIEW ============

model Review {
  id               String   @id @default(cuid())

  // Content
  rating           Int      // 1-5
  text             String
  photos           String   @default("[]")

  // Relations
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  providerId       String
  provider         Provider @relation(fields: [providerId], references: [id])

  // Verification
  isVerifiedInteraction Boolean @default(false)

  // Moderation
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  moderatedBy      String?
  moderatedAt      DateTime?
  moderationReason String?

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([providerId])
  @@index([status])
  @@index([rating])
}

// ============ FAVORITE ============

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@index([userId])
}

// ============ ANALYTICS ============

model AnalyticsEvent {
  id         String    @id @default(cuid())

  // Event info
  event      String
  properties String    @default("{}")
  sessionId  String

  // Context
  userId     String?
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  // Device/Platform
  platform   String?
  userAgent  String?

  // Location
  lat        Float?
  lng        Float?
  city       String?

  // Timestamp
  timestamp  DateTime  @default(now())

  @@index([event])
  @@index([providerId])
  @@index([sessionId])
  @@index([timestamp])
}

// ============ MONETIZATION ============

model ClickLedger {
  id          String   @id @default(cuid())

  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])

  eventType   String   // call, whatsapp, navigate, website
  isBillable  Boolean  @default(true)
  amount      Float?

  sessionId   String?
  userId      String?

  timestamp   DateTime @default(now())

  @@index([providerId])
  @@index([eventType])
  @@index([timestamp])
  @@index([isBillable])
}

// ============ OTP (for phone auth) ============

model OTP {
  id         String    @id @default(cuid())
  phone      String
  code       String
  attempts   Int       @default(0)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  @@index([phone])
  @@index([expiresAt])
}

// ============ IMPORT LOG ============

model ImportLog {
  id           String    @id @default(cuid())
  filename     String
  rowCount     Int
  importedCount Int
  errorCount   Int
  errors       String?
  status       String    // pending, processing, completed, failed
  createdBy    String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
}
